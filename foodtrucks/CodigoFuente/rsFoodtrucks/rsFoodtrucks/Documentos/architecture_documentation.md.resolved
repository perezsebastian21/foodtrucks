## 4. Modelo de Datos (Entidades)

```mermaid
erDiagram
    FT_Foodtrucks ||--o{ FT_FoodtruckFT_Categoria : "tiene"
    FT_Categorias ||--o{ FT_FoodtruckFT_Categoria : "pertenece"
    FT_Usuarios {
        int IdUsuario PK
        string Usuario
        string Email
        bool Activo
    }
    FT_Foodtrucks {
        int IdFT PK
        string NombreFantasia
        byte[] Logo
        string Titular
        string EmailContacto
        string Menu
        string Vegano
        string Vegetariano
        string SinTACC
        string Emplazado
        string Celiaco
        string Estado
        string CelContacto
        string CuitCuil
        string DomicilioLegal
        string Telefono
        string EmailTitular
        string NumeroRegistro
        date FechaVencimiento
        string SolicitudIngreso
        string Consumo
        byte[] CartaMenu
        byte[] DniFrente
        byte[] DniDorso
        byte[] FtFrente
        byte[] FtTrasera
        byte[] FtIzquierda
        byte[] FtDerecha
        byte[] Habilitacion
        byte[] ManipulacionAlimentos
    }
    FT_Categorias {
        int IdCategoria PK
        string Nombre
